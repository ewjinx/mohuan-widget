<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_m3_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Material You Device Header Card -->
    <LinearLayout
        android:id="@+id/btn_on"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.25"
        android:background="@drawable/bg_m3_header_on"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="LED Strip"
                android:textColor="@color/m3_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="On • Warm"
                android:textColor="@color/m3_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_off"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/circle_power_on">

            <ImageView
                android:id="@+id/img_power"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_power_on" />
        </FrameLayout>
    </LinearLayout>

    <!-- Row 2: Pastel Color Swatches -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:layout_weight="0.95"
        android:background="@drawable/bg_m3_track"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:id="@+id/btn_red"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/swatch_red" />
            <ImageView
                android:id="@+id/dot_red"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:src="@drawable/dot_selected"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_green"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/swatch_green" />
            <ImageView
                android:id="@+id/dot_green"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:src="@drawable/dot_selected"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_blue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/swatch_blue" />
            <ImageView
                android:id="@+id/dot_blue"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:src="@drawable/dot_selected"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_purple"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/swatch_purple" />
            <ImageView
                android:id="@+id/dot_purple"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:src="@drawable/dot_selected"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_warm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/swatch_warm" />
            <ImageView
                android:id="@+id/dot_warm"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:src="@drawable/dot_selected"
                android:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Row 3: Two Balanced Material You Bento Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_bright"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_m3_bento"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_brightness" />

            <TextView
                android:id="@+id/txt_bri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="100%"
                android:textColor="@color/m3_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_rainbow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_m3_bento"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_fade" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Fade"
                android:textColor="@color/m3_text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>